# Release 1.0 shapes: an ellipse, an L shape and a rotated ellipse.
dungeon "ellipse_l" {
    name = "Ellipse and L"

    room "nave" {
        name = "Nave"
        shape = ellipse(10, 6)
        layout { position = [0, 0] }

        feature "font" {
            type = furniture
            subtype = altar
            placement { anchor = center }
        }
    }

    room "transept" {
        name = "Transept"
        shape = l_shape(8, 6, [3, 2])
        layout { south_of = "nave" }
    }

    room "apse" {
        name = "Apse"
        shape = ellipse(4, 8)
        rotation = 90

        layout {
            east_of = "nave"
            gap = 1
        }
    }

    connection "nave_south" {
        from = "nave"
        to = "transept"
        type = archway
        placement { width = 2 }
    }

    connection "nave_east" {
        from = "nave"
        to = "apse"
        type = door
    }
}
