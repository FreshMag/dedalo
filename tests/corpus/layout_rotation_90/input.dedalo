# An L-shaped room turned 90 degrees, with a wall-mounted torch.
dungeon "layout_rotation_90" {
    room "turned" {
        shape = l_shape(6, 4, 2)
        rotation = 90

        feature "torch" {
            type = lighting
            subtype = torch
            placement { wall = north }
        }

        feature "chest" {
            type = container
            position = [0, 0]
        }
    }

    room "next" {
        shape = square(3)
        layout { south_of = "turned", align = start }
    }

    connection "link" {
        from = "turned"
        to = "next"
        type = door
    }
}
