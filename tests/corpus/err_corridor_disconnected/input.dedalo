dungeon "d" {
    room "a" {
        shape = square(4)
        layout { position = [0, 0] }
    }

    room "b" {
        shape = square(4)
        layout { position = [10, 10] }
    }

    corridor "diagonal" {
        connects = ["a", "b"]
    }

    corridor "short" {
        connects = ["a", "b"]
        path = [[4, 1.5], [7, 1.5], [7, 6]]
    }
}
