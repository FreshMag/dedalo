# Absolute positions, including negative coordinates.
dungeon "layout_absolute_negative" {
    room "a" {
        shape = square(4)
        layout { position = [-6, -4] }
    }

    room "b" {
        shape = rectangle(6, 4)
        layout { position = [-2, -4] }
    }

    connection "ab" {
        from = "a"
        to = "b"
        type = door
    }
}
