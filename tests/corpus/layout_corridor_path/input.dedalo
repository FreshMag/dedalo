# An explicit path with two bends.
dungeon "layout_corridor_path" {
    room "a" {
        shape = square(4)
        layout { position = [0, 0] }
    }

    room "b" {
        shape = square(4)
        layout { position = [10, 8] }
    }

    corridor "winding" {
        connects = ["a", "b"]
        path = [[4, 1.5], [6.5, 1.5], [6.5, 9.5], [10, 9.5]]
    }
}
