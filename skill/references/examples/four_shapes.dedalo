# Four rooms of four different shapes, joined by doors, a secret door and
# corridors: the exit criterion of milestone M2.
dungeon "four_shapes" {
    name = "Four Shapes"

    grid {
        unit = "5ft"
    }

    room "hall" {
        name = "Hall"
        shape = rectangle(10, 6)
        tags = ["entrance"]

        layout {
            position = [0, 0]
        }

        entity "steward" {
            type = npc
            name = "Steward"
            position = [8, 1]
            facing = south_west
            visibility = public
        }

        feature "rubble" {
            type = terrain
            subtype = rubble
            position = [0, 4]
            size = [2, 2]
        }
    }

    # A circle one cell away: the door gets a short stub passage.
    room "rotunda" {
        name = "Rotunda"
        shape = circle(3)

        layout {
            east_of = "hall"
            gap = 1
        }

        feature "idol" {
            type = furniture
            subtype = statue
            placement { anchor = center }
        }
    }

    room "vault" {
        name = "Vault"
        shape = square(4)

        layout {
            south_of = "hall"
            align = start
        }

        feature "lever" {
            type = mechanism
            subtype = lever

            placement {
                wall = west
                offset = 1
            }

            properties {
                linked_to = ["cell_door"]
            }
        }
    }

    # An L-shaped polygon, three cells north of the hall.
    room "gallery" {
        name = "Gallery"
        shape = polygon([[0, 0], [6, 0], [6, 3], [3, 3], [3, 6], [0, 6]])

        layout {
            north_of = "hall"
            align = end
            gap = 3
        }

        feature "pool" {
            type = terrain
            subtype = water
            position = [4, 0]
            size = [2, 2]
        }

        feature "sigil" {
            type = custom
            position = [1, 4]

            properties {
                symbol = "Si"
                label = "Arcane sigil"
            }
        }
    }

    room "cell" {
        name = "Cell"
        shape = square(3)

        layout {
            position = [8, 9]
        }
    }

    # Automatic routing: straight across the gap.
    corridor "north_hall" {
        connects = ["hall", "gallery"]
        width = 2
    }

    # Explicit routing with one bend. Half-cell coordinates keep a corridor
    # of width 1 on the grid.
    corridor "bend" {
        connects = ["vault", "cell"]
        path = [[4, 7.5], [6.5, 7.5], [6.5, 10.5], [8, 10.5]]
    }

    connection "rotunda_door" {
        from = "hall"
        to = "rotunda"
        type = door
    }

    connection "vault_door" {
        from = "hall"
        to = "vault"
        type = secret_door
    }

    # A door at the end of the corridor instead of its open end.
    connection "cell_door" {
        from = "bend"
        to = "cell"
        type = locked_door
    }

    connection "way_down" {
        from = "cell"
        type = stairs
        position = [1, 1]
    }

    note "idol_note" {
        target = "idol"
        text = "The idol turns to face whoever enters the rotunda."
    }

    export "dm" {
        preset = dm
    }

    export "player" {
        preset = player
    }

    export "clean" {
        preset = clean
    }

    export "turned" {
        preset = dm
        rotation = 90
    }
}
